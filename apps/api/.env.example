# Copy to .env and fill in real values for local development.

NODE_ENV=development
PORT=3000

# Postgres connection string — matches the root docker-compose.yml service.
DATABASE_URL="postgresql://identiq:identiq@localhost:5432/identiq"

# Generate with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN=7d

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# The deployed contracts/identity contract id.
IDENTITY_CONTRACT_ID=""
# The platform's own operational Stellar signer — never a user's key.
# Generate a keypair with `stellar keys generate` and fund it on testnet
# via https://laboratory.stellar.org/#account-creator?network=test
PLATFORM_SIGNER_SECRET=""

CORS_ORIGIN=http://localhost:3001
# Used to build links in outgoing emails (e.g. "View in dashboard").
WEB_URL=http://localhost:3001

# Optional — outgoing email (credential/permission notifications).
# Leave unset in development: emails are logged instead of sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Identiq <notifications@identiq.app>"
